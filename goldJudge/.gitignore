# never commit trajectory data or screenshots
data/**/*.png
data/**/*.jpg
data/**/*.mp4
data/**/*.zip
data/raw/
# judge outputs can be large; keep only summaries by default
data/judge/**/*.jsonl
__pycache__/
*.egg-info/
.pytest_cache/
config/*.env
# action logs and subgoal-pipeline outputs are regenerable; keep only coverage/metrics CSVs
data/actions/**/*.json
data/subgoals/**/*.json
data/subgoals/**/*.jsonl
data/textgoals/**/*.json
data/ideas/**/*.json
data/stepcheck/**/*.json
data/constraints/**/*.json
data/harness2/**/*.json
data/cuadebugger/**/*.json
