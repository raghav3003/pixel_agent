# Copy to config/judge.env (git-ignored). Loaded by run_judge.py / smoke_judge.py.
# --- Anthropic (pipeline validation with the cheapest model) ---
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-...
